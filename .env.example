# Azure AD app registration (client credentials flow)
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=

# Mailbox this server acts on by default (can be overridden per-call via the
# optional `mailbox` argument on most tools)
OUTLOOK_USER_EMAIL=

# Optional: comma-separated Graph folder IDs to exclude from
# get_recent_emails_all_folders. Leave unset to skip no folders.
OUTLOOK_EXCLUDED_FOLDER_IDS=

# Optional: master on/off switch for the exclusion list above.
# Defaults to false (no filtering) if unset.
OUTLOOK_SKIP_EXCLUDED_FOLDERS=false

# Optional: sign-off name used in triage_email's suggested-reply templates.
# Defaults to "The Team" if unset.
OUTLOOK_SIGNOFF_NAME=
